{
  "manifest_version": 3,
  "name": "Meet Record Reminder",
  "version": "1.0",
  "description": "Google Meet参加時に画面収録を促す通知を表示します",
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
